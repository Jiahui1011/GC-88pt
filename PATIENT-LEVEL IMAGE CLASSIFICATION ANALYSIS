    "Precision",
    "F1",
    "AUC"
]

summary_rows = []

for (dataset, model), group in patient_df.groupby(
    ["Dataset", "Model"]
):

    row = {
        "Dataset": dataset,
        "Model": model,
        "N_Patients": len(group),
        "Total_Images": int(group["N_Images"].sum()),
        "Threshold": THRESHOLD
    }

    for metric in METRICS:

        valid = group[metric].dropna()

        row[f"{metric}_N"] = len(valid)

        row[f"{metric}_Mean"] = (
            valid.mean()
            if len(valid) > 0
            else np.nan
        )

        row[f"{metric}_SD"] = (
            valid.std(ddof=1)
            if len(valid) > 1
            else np.nan
        )

        row[f"{metric}_Median"] = (
            valid.median()
            if len(valid) > 0
            else np.nan
        )

        row[f"{metric}_Min"] = (
            valid.min()
            if len(valid) > 0
            else np.nan
        )

        row[f"{metric}_Max"] = (
            valid.max()
            if len(valid) > 0
            else np.nan
        )

    summary_rows.append(row)


