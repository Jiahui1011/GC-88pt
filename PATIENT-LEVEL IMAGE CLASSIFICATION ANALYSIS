# ================================================================
# 2. LOAD PATIENT REFERENCE
# ================================================================

def load_reference(split):

    file_path = (
        REFERENCE_DIR
        / f"{split}_Patient_Reference.csv"
    )

    df = pd.read_csv(file_path)

    df["pid"] = (
        df["pid"]
        .astype(str)
        .str.strip()
        .str.upper()
    )

    if df["pid"].duplicated().any():
        raise ValueError(
            f"Duplicate patient IDs: {file_path}"
        )

    if not (df["audit_status"] == "OK").all():
        raise ValueError(
            f"Unresolved audit warnings: {file_path}"
        )

    return df


references = {
    split: load_reference(split)
    for split in ["Validation", "Test"]
}


# ================================================================
# 3. LOAD PREDICTION CACHE
# ================================================================

def load_cache(model, split):

    file_path = (
        CACHE_DIR
        / f"{model}_{split}.csv"
    )

    if not file_path.exists():
        raise FileNotFoundError(file_path)

    df = pd.read_csv(file_path)

    required = {"pid", "gt", "score"}

    missing = required - set(df.columns)

    if missing:
        raise ValueError(
            f"Missing columns in {file_path}: {missing}"
        )

    df["pid"] = (
        df["pid"]
        .astype(str)
        .str.strip()
        .str.upper()
    )

    df["gt"] = pd.to_numeric(
        df["gt"],
        errors="raise"
    )

    df["score"] = pd.to_numeric(
        df["score"],
        errors="raise"
    )

    if not df["gt"].isin([0, 1]).all():
        raise ValueError(
            f"Invalid GT values in {file_path}"
        )

    if not np.isfinite(df["score"]).all():
        raise ValueError(
            f"Invalid scores in {file_path}"
        )

    if not df["score"].between(0, 1).all():
        raise ValueError(
            f"Scores outside [0,1]: {file_path}"
        )

    return df


# ================================================================
# 4. METRIC FUNCTIONS
# ================================================================

def safe_divide(numerator, denominator):

    if denominator == 0:
        return np.nan

    return numerator / denominator


def calculate_metrics(
    y_true,
    scores,
    threshold=0.50
):

    y_true = np.asarray(
        y_true,
        dtype=int
    )

    scores = np.asarray(
        scores,
        dtype=float
    )

    y_pred = (
        scores >= threshold
    ).astype(int)

    tn, fp, fn, tp = confusion_matrix(
        y_true,
        y_pred,
        labels=[0, 1]
    ).ravel()

    sensitivity = safe_divide(
        tp,
        tp + fn
    )

    specificity = safe_divide(
        tn,
        tn + fp
    )

    accuracy = safe_divide(
        tp + tn,
        tp + tn + fp + fn
    )

    precision = safe_divide(
        tp,
        tp + fp
    )

    f1 = safe_divide(
        2 * tp,
        2 * tp + fp + fn
    )

    if len(np.unique(y_true)) == 2:

        auc = roc_auc_score(
            y_true,
            scores
        )

    else:

        auc = np.nan

    return {
        "N_Images": len(y_true),
        "N_Positive": int(np.sum(y_true == 1)),
        "N_Negative": int(np.sum(y_true == 0)),
        "TP": int(tp),
        "TN": int(tn),
        "FP": int(fp),
        "FN": int(fn),
        "Sensitivity": sensitivity,
        "Specificity": specificity,
        "Accuracy": accuracy,
        "Precision": precision,
        "F1": f1,
        "AUC": auc
    }


# ================================================================
# 5. MAIN PATIENT-LEVEL ANALYSIS
# ================================================================

patient_results = []
pooled_results = []

for dataset_name, split in DATASETS.items():

    print("\n" + "=" * 100)
    print(f"DATASET: {dataset_name}")
    print("=" * 100)

    reference = references[split]

    for model in MODELS:

        print(f"Processing {model} ...")

        cache = load_cache(
            model,
            split
        )

        cache_ids = set(cache["pid"])
        reference_ids = set(reference["pid"])

        if cache_ids != reference_ids:

            raise ValueError(
                f"{model} {split}: "
                f"Patient IDs do not match reference.\n"
                f"Missing: {reference_ids - cache_ids}\n"
                f"Extra: {cache_ids - reference_ids}"
            )

        # --------------------------------------------------------
        # Verify tile ground truth against audited patient totals
        # --------------------------------------------------------

        if {
            "n_tiles",
            "n_positive_tiles",
            "n_negative_tiles"
        }.issubset(reference.columns):

            counts = (
                cache.groupby("pid")
                .agg(
                    n_tiles=("gt", "size"),
                    n_positive_tiles=("gt", "sum")
                )
                .reset_index()
            )

            counts["n_negative_tiles"] = (
                counts["n_tiles"]
                - counts["n_positive_tiles"]
            )

            check = reference.merge(
                counts,
                on="pid",
                suffixes=("_reference", "_cache"),
                validate="one_to_one"
            )

            for col in [
                "n_tiles",
                "n_positive_tiles",
                "n_negative_tiles"
            ]:

                if not (
                    check[f"{col}_reference"]
                    == check[f"{col}_cache"]
                ).all():

                    raise ValueError(
                        f"{model} {split}: "
                        f"GT count mismatch for {col}"
                    )

        # --------------------------------------------------------
        # Attach cohort information
        # --------------------------------------------------------

        cache = cache.merge(
            reference[
                [
                    "pid",
                    "cohort"
                ]
            ],
            on="pid",
            how="left",
            validate="many_to_one"
        )

        if cache["cohort"].isna().any():
            raise ValueError(
                f"Missing cohort information: {model}"
            )

        # --------------------------------------------------------
        # Individual patient evaluation
        # --------------------------------------------------------

        for pid, patient_df in cache.groupby("pid"):

            metrics = calculate_metrics(
                patient_df["gt"],
                patient_df["score"],
                THRESHOLD
            )

            metrics.update({
                "Dataset": dataset_name,
                "Model": model,
                "Patient": pid,
                "Cohort": patient_df["cohort"].iloc[0],
                "Threshold": THRESHOLD
            })

            patient_results.append(metrics)

        # --------------------------------------------------------
        # Pooled image-level evaluation
        # --------------------------------------------------------

        pooled = calculate_metrics(
            cache["gt"],
            cache["score"],
            THRESHOLD
        )

        pooled.update({
            "Dataset": dataset_name,
            "Model": model,
            "Threshold": THRESHOLD
        })

        pooled_results.append(pooled)


