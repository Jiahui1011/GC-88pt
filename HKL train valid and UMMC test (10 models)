class TorchvisionTestDataset(Dataset):
    def __init__(self, image_paths, img_size=640):
        self.image_paths = image_paths
        self.img_size = img_size

    def __len__(self):
        return len(self.image_paths)

    def __getitem__(self, idx):
        img_path = self.image_paths[idx]
        image = Image.open(img_path).convert("RGB")
        boxes, labels = load_yolo_labels(img_path)
        orig_w, orig_h = image.size
        
        image = image.resize((self.img_size, self.img_size), Image.BILINEAR)

        if len(boxes) > 0:
            boxes[:, [0, 2]] *= (self.img_size / orig_w)
            boxes[:, [1, 3]] *= (self.img_size / orig_h)

        return TF.to_tensor(image), {"boxes": boxes, "labels": labels, "image_id": torch.tensor([idx])}, img_path
        
def eval_ultralytics(model_name, weights_path):
    is_rtdetr = "RT-DETR" in model_name
    model = RTDETR(weights_path) if is_rtdetr else YOLO(weights_path)

    params = sum(p.numel() for p in model.model.parameters()) / 1e6 if hasattr(model, "model") else np.nan
    gflops = np.nan
    if not is_rtdetr:
        try:
            info = model.info(verbose=False)
            if isinstance(info, tuple) and len(info) >= 2: gflops = float(info[-1])
        except Exception: pass

    precision, recall, f1, map50, map5095 = np.nan, np.nan, np.nan, np.nan, np.nan
    val_success = False
    
    if not is_rtdetr:
        try:
            val_res = model.val(data=DATASET_YAML, split="test", imgsz=IMG_SIZE, device=DEVICE_ID, batch=8, workers=2, verbose=False, plots=False)
            precision, recall = float(val_res.box.mp), float(val_res.box.mr)
            f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else np.nan
            map50, map5095 = float(val_res.box.map50), float(val_res.box.map)
            val_success = True
        except Exception as e:
            print(f"  -> Skipping built-in val() for {model_name}: {e}")

    results = model.predict(source=TEST_TXT, conf=0.001, imgsz=IMG_SIZE, device=DEVICE_ID, stream=True, verbose=False, batch=8)

    tile_scores, tile_gts, inference_times = [], [], []
    patient_data = {}
    
    if not val_success:
        map_metric = MeanAveragePrecision(box_format="xyxy", iou_type="bbox", class_metrics=False)
        all_preds, all_targets = [], []

    for res in results:
        if hasattr(res, "speed") and "inference" in res.speed:
            inference_times.append(res.speed["inference"])

        gt_boxes, gt_labels = load_yolo_labels(res.path)
        gt = 1 if len(gt_boxes) > 0 else 0
        max_conf = float(res.boxes.conf.max().item()) if (res.boxes is not None and len(res.boxes) > 0) else 0.0

        tile_scores.append(max_conf)
        tile_gts.append(gt)

        # Aggregating Patient Level Scores
        pid = get_patient_id(res.path)
        if pid not in patient_data:
            patient_data[pid] = {"score": 0.0, "gt": 0}
        patient_data[pid]["score"] = max(patient_data[pid]["score"], max_conf)
        patient_data[pid]["gt"] = max(patient_data[pid]["gt"], gt)

        if not val_success:
            if res.boxes is not None and len(res.boxes) > 0:
                pred_boxes = res.boxes.xyxy.cpu()
                pred_scores = res.boxes.conf.cpu()
                pred_labels = torch.ones_like(res.boxes.cls.cpu(), dtype=torch.int64)
            else:
                pred_boxes = torch.empty((0, 4))
                pred_scores, pred_labels = torch.empty((0,)), torch.empty((0,), dtype=torch.int64)

            all_preds.append({"boxes": pred_boxes, "scores": pred_scores, "labels": pred_labels})
            all_targets.append({"boxes": gt_boxes, "labels": gt_labels})

    tile_class_metrics = calculate_classification_metrics(tile_gts, tile_scores)
    pat_scores = [v["score"] for v in patient_data.values()]
    pat_gts = [v["gt"] for v in patient_data.values()]
    pat_class_metrics = calculate_classification_metrics(pat_gts, pat_scores)

    latency = np.mean(inference_times) if len(inference_times) > 0 else np.nan
    fps = (1000.0 / latency) if (latency and latency > 0) else np.nan
    train_time = get_training_time(weights_path)

    if not val_success:
        print(f"  -> Calculating COCO mAP mathematically for {model_name}...")
        map_metric.update(all_preds, all_targets)
        map_res = map_metric.compute()
        map50, map5095 = float(map_res["map_50"]), float(map_res["map"])
        det_metrics = detection_precision_recall(all_preds, all_targets)
        precision, recall, f1 = det_metrics["Precision"], det_metrics["Recall"], det_metrics["F1 score"]

    tile_row = {
        "Model": model_name, "Level": "Tile", "Precision": precision, "Recall": recall, "F1 score": f1,
        "mAP50": map50, "mAP50-95": map5095, "Total Training Time": train_time, "Total Parameters (M)": params,
        "GFLOPs": gflops, "Latency (ms/img)": latency, "FPS": fps, **tile_class_metrics
    }
    
    pat_row = {
        "Model": model_name, "Level": "Patient", "Precision": np.nan, "Recall": np.nan, "F1 score": np.nan,
        "mAP50": np.nan, "mAP50-95": np.nan, "Total Training Time": train_time, "Total Parameters (M)": params,
        "GFLOPs": gflops, "Latency (ms/img)": latency, "FPS": fps, **pat_class_metrics
    }

    return [tile_row, pat_row]

def eval_torchvision(model_name, weights_path):
    model = get_optimized_tv_model(model_name)
    model.load_state_dict(torch.load(weights_path, map_location=DEVICE))
    model.to(DEVICE)
    model.eval()
    
    params = sum(p.numel() for p in model.parameters()) / 1e6
    gflops = np.nan
    try:
        from thop import profile
        macs, _ = profile(model, inputs=([torch.randn(1, 3, IMG_SIZE, IMG_SIZE).to(DEVICE)],), verbose=False)
        gflops = float((macs * 2) / 1e9)
    except Exception:
        pass

    dataloader = DataLoader(TorchvisionTestDataset(TEST_IMAGES, IMG_SIZE), batch_size=8, shuffle=False, num_workers=0, collate_fn=lambda x: tuple(zip(*x)))

    metric = MeanAveragePrecision(box_format="xyxy", iou_type="bbox", class_metrics=False)
    all_preds, all_targets, tile_scores, tile_gts, inference_times = [], [], [], [], []
    patient_data = {}

    with torch.no_grad():
        for images, targets, paths in dataloader:
            images_device = [img.to(DEVICE) for img in images]
            if torch.cuda.is_available(): torch.cuda.synchronize()
            start = time.perf_counter()
            predictions = model(images_device)
            if torch.cuda.is_available(): torch.cuda.synchronize()
            
            batch_time = (time.perf_counter() - start) * 1000
            inference_times.extend([batch_time / len(images)] * len(images))

            preds_cpu = [{"boxes": p["boxes"].detach().cpu(), "scores": p["scores"].detach().cpu(), "labels": p["labels"].detach().cpu()} for p in predictions]
            targets_cpu = [{"boxes": t["boxes"].detach().cpu(), "labels": t["labels"].detach().cpu()} for t in targets]

            metric.update(preds_cpu, targets_cpu)
            all_preds.extend(preds_cpu)
            all_targets.extend(targets_cpu)

            for j, p in enumerate(preds_cpu):
                img_path = paths[j]
                gt = 1 if len(targets_cpu[j]["boxes"]) > 0 else 0
                max_conf = float(p["scores"].max().item()) if len(p["scores"]) > 0 else 0.0
                
                tile_gts.append(gt)
                tile_scores.append(max_conf)
                
                # Aggregating Patient Level Scores
                pid = get_patient_id(img_path)
                if pid not in patient_data:
                    patient_data[pid] = {"score": 0.0, "gt": 0}
                patient_data[pid]["score"] = max(patient_data[pid]["score"], max_conf)
                patient_data[pid]["gt"] = max(patient_data[pid]["gt"], gt)

    map_res = metric.compute()
    det_metrics = detection_precision_recall(all_preds, all_targets)
    
    tile_class_metrics = calculate_classification_metrics(tile_gts, tile_scores)
    pat_scores = [v["score"] for v in patient_data.values()]
    pat_gts = [v["gt"] for v in patient_data.values()]
    pat_class_metrics = calculate_classification_metrics(pat_gts, pat_scores)

    latency = np.mean(inference_times) if len(inference_times) > 0 else np.nan
    fps = (1000.0 / latency) if (latency and latency > 0) else np.nan

    tile_row = {
        "Model": model_name, "Level": "Tile", "Precision": det_metrics["Precision"], "Recall": det_metrics["Recall"], "F1 score": det_metrics["F1 score"],
        "mAP50": float(map_res["map_50"]), "mAP50-95": float(map_res["map"]), "Total Training Time": np.nan, "Total Parameters (M)": params,
        "GFLOPs": gflops, "Latency (ms/img)": latency, "FPS": fps, **tile_class_metrics
    }
    pat_row = {
        "Model": model_name, "Level": "Patient", "Precision": np.nan, "Recall": np.nan, "F1 score": np.nan,
        "mAP50": np.nan, "mAP50-95": np.nan, "Total Training Time": np.nan, "Total Parameters (M)": params,
        "GFLOPs": gflops, "Latency (ms/img)": latency, "FPS": fps, **pat_class_metrics
    }

    return [tile_row, pat_row]

