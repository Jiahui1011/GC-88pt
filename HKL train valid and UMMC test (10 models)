def load_yolo_labels(img_path):
    label_path = str(img_path).replace(os.sep + "images" + os.sep, os.sep + "labels" + os.sep)
    label_path = os.path.splitext(label_path)[0] + ".txt"
    if not os.path.exists(label_path):
        return torch.empty((0, 4), dtype=torch.float32), torch.empty((0,), dtype=torch.int64)

    image = Image.open(img_path)
    w, h = image.size
    boxes, labels = [], []
    with open(label_path, "r") as f:
        for line in f:
            parts = line.strip().split()
            if len(parts) >= 5:
                _, cx, cy, bw, bh = map(float, parts[:5])
                x1, y1 = (cx - bw / 2.0) * w, (cy - bh / 2.0) * h
                x2, y2 = (cx + bw / 2.0) * w, (cy + bh / 2.0) * h
                if x2 > x1 and y2 > y1:
                    boxes.append([x1, y1, x2, y2])
                    labels.append(1)

    if len(boxes) == 0:
        return torch.empty((0, 4), dtype=torch.float32), torch.empty((0,), dtype=torch.int64)
    return torch.tensor(boxes, dtype=torch.float32), torch.tensor(labels, dtype=torch.int64)

def has_ground_truth(img_path):
    boxes, _ = load_yolo_labels(img_path)
    return len(boxes) > 0

