def find_best_weights(run_name):
    # Candidate locations where Ultralytics stores Site_Split_Run
    search_dirs = [
        Path(PROJECT_ROOT),
        Path("./runs/detect/Site_Split_Run"),
        Path("./runs/detect"),
        Path("./Jia Hui/runs/detect/Site_Split_Run")
    ]
    
    candidates = []
    for s_dir in search_dirs:
        if s_dir.exists():
            for p in s_dir.rglob("best.pt"):
                p_str = str(p).lower()
                # STRICT FILTER: Must belong to Site_Split_Run AND match model name
                if "site_split_run" in p_str and run_name.lower() in p_str:
                    candidates.append(p)

    if not candidates:
        return None

    # Pick the most recently generated best.pt
    candidates.sort(key=lambda x: x.stat().st_mtime, reverse=True)
    return str(candidates[0])


