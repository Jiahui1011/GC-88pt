class SynchronizedYOLODataset(Dataset):
    def __init__(self, txt_list_path, is_train=True, img_size=640):
        with open(txt_list_path, "r") as f:
            self.image_paths = [line.strip() for line in f if line.strip()]
        self.is_train = is_train
        self.img_size = img_size
        self.has_ganglion = [1 if has_ground_truth(p) else 0 for p in self.image_paths]

    def __len__(self): return len(self.image_paths)

    def __getitem__(self, idx):
        img_path = self.image_paths[idx]
        image = Image.open(img_path).convert("RGB")
        boxes, labels = load_yolo_labels(img_path)
        orig_w, orig_h = image.size

        image = image.resize((self.img_size, self.img_size), Image.BILINEAR)
        if len(boxes) > 0:
            boxes[:, [0, 2]] *= (self.img_size / orig_w)
            boxes[:, [1, 3]] *= (self.img_size / orig_h)
            
            if self.is_train:
                if random.random() > 0.5:
                    image = TF.hflip(image)
                    boxes = torch.tensor([[self.img_size - b[2], b[1], self.img_size - b[0], b[3]] for b in boxes])
                if random.random() > 0.5:
                    image = TF.vflip(image)
                    boxes = torch.tensor([[b[0], self.img_size - b[3], b[2], self.img_size - b[1]] for b in boxes])
                if random.random() > 0.5:
                    image = TF.adjust_brightness(image, random.uniform(0.9, 1.1))
                    image = TF.adjust_contrast(image, random.uniform(0.9, 1.1))

        if len(boxes) > 0:
            boxes = torch.as_tensor(boxes, dtype=torch.float32)
            labels = torch.as_tensor(labels, dtype=torch.int64)
        else:
            boxes = torch.empty((0, 4), dtype=torch.float32)
            labels = torch.empty((0,), dtype=torch.int64)

        return TF.to_tensor(image), {"boxes": boxes, "labels": labels, "image_id": torch.tensor([idx])}, img_path

def get_optimized_tv_model(model_name):
    if model_name == "Faster_RCNN":
        anchor_generator = AnchorGenerator(sizes=((16,), (32,), (64,), (128,), (256,)), aspect_ratios=((0.5, 1.0, 2.0),) * 5)
        model = fasterrcnn_resnet50_fpn(weights=FasterRCNN_ResNet50_FPN_Weights.DEFAULT, rpn_anchor_generator=anchor_generator, min_size=640, max_size=640, box_score_thresh=0.05)
        in_features = model.roi_heads.box_predictor.cls_score.in_features
        model.roi_heads.box_predictor = FastRCNNPredictor(in_features, num_classes=2)
    elif model_name == "SSD_VGG16":
        model = ssd300_vgg16(weights=SSD300_VGG16_Weights.DEFAULT)
        num_anchors = model.anchor_generator.num_anchors_per_location()
        model.head = SSDHead([512, 1024, 512, 256, 256, 256], num_anchors, num_classes=2)
    return model

def train_single_torchvision(model_name):
    save_path = WEIGHTS[model_name]
    if os.path.exists(save_path):
        print(f"[{model_name}] Weights found at {save_path}. Skipping training.")
        return
        
    print(f"\n{'='*80}\nTRAINING TORCHVISION: {model_name}\n{'='*80}")
    
    train_dataset = SynchronizedYOLODataset(TRAIN_TXT, is_train=True, img_size=IMG_SIZE)
    val_dataset = SynchronizedYOLODataset(VAL_TXT, is_train=False, img_size=IMG_SIZE)

    weights = [3.0 if has_cell == 1 else 1.0 for has_cell in train_dataset.has_ganglion]
    sampler = WeightedRandomSampler(weights, num_samples=len(weights), replacement=True)

    train_loader = DataLoader(train_dataset, batch_size=TV_BATCH_SIZE, sampler=sampler, collate_fn=lambda x: tuple(zip(*x)), num_workers=0)
    val_loader = DataLoader(val_dataset, batch_size=TV_BATCH_SIZE, shuffle=False, collate_fn=lambda x: tuple(zip(*x)), num_workers=0)

    model = get_optimized_tv_model(model_name).to(DEVICE)
    optimizer = torch.optim.SGD(model.parameters(), lr=0.005 if model_name == "Faster_RCNN" else 0.001, momentum=0.9, weight_decay=0.0005)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=TV_EPOCHS, eta_min=1e-5)
    scaler = torch.amp.GradScaler('cuda')
    best_loss = float('inf')
    patience_counter = 0

    for epoch in range(TV_EPOCHS):
        model.train()
        train_loss = 0.0
        
        train_pbar = tqdm(train_loader, desc=f"Epoch {epoch+1}/{TV_EPOCHS} [Train]")
        for images, targets, _ in train_pbar:
            images = list(img.to(DEVICE) for img in images)
            targets = [{k: v.to(DEVICE) for k, v in t.items()} for t in targets]
            
            optimizer.zero_grad()
            with torch.amp.autocast('cuda'):
                loss_dict = model(images, targets)
                losses = sum(loss for loss in loss_dict.values())
            
            scaler.scale(losses).backward()
            scaler.unscale_(optimizer)
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=10.0)
            scaler.step(optimizer)
            scaler.update()
            
            train_loss += losses.item()
            train_pbar.set_postfix(loss=f"{losses.item():.4f}")
            
        scheduler.step()
        model.train() 
        val_loss = 0.0
        with torch.no_grad():
            for images, targets, _ in val_loader:
                images = list(img.to(DEVICE) for img in images)
                targets = [{k: v.to(DEVICE) for k, v in t.items()} for t in targets]
                with torch.amp.autocast('cuda'):
                    loss_dict = model(images, targets)
                    val_loss += sum(loss for loss in loss_dict.values()).item()

        print(f"Epoch {epoch+1}/{TV_EPOCHS} | Train Loss: {train_loss:.4f} | Val Loss: {val_loss:.4f}")
        
        if val_loss < best_loss:
            best_loss = val_loss
            patience_counter = 0
            torch.save(model.state_dict(), save_path)
            print(f" -> Saved new best weights ({save_path})")
        else:
            patience_counter += 1
            if patience_counter >= TV_PATIENCE:
                print(f"Early stopping at epoch {epoch+1}.")
                break
    del model
    cleanup()

