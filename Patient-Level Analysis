    def set_cell_bg(cell, hex_color):
        tc   = cell._tc
        tcPr = tc.get_or_add_tcPr()
        shd  = OxmlElement("w:shd")
        shd.set(qn("w:val"),   "clear")
        shd.set(qn("w:color"), "auto")
        shd.set(qn("w:fill"),  hex_color)
        tcPr.append(shd)

    def write_cell(cell, text, bold=False, size=9,
                   align="center", fg=None, bg=None):
        if bg:
            set_cell_bg(cell, bg)
        cell.text = ""
        para = cell.paragraphs[0]
        para.alignment = (WD_ALIGN_PARAGRAPH.CENTER
                          if align == "center"
                          else WD_ALIGN_PARAGRAPH.LEFT)
        run = para.add_run(text)
        run.bold = bold
        run.font.size = Pt(size)
        if fg:
            run.font.color.rgb = RGBColor(*fg)

    # Colour scheme for specificity column
    def spec_bg(v):
        if   v >= 1.00: return "C6EFCE"   # green
        elif v >= 0.60: return "FFEB9C"   # amber
        else:           return "FFC7CE"   # red

    # Colour scheme for AUC column
    def auc_bg(v):
        if   v >= 0.999: return "C6EFCE"
        elif v >= 0.950: return "FFEB9C"
        else:            return "FFC7CE"

    doc = Document()
    doc.add_heading(
        "Patient-Level Performance — External Validation (UMMC)", level=1)

