        "Sensitivity\n[95% CI]",
        "Specificity\n[95% CI]",
        "Accuracy\n[95% CI]",
        "F1",
        "AUC\n[95% CI]",
    ]
    # cm widths — total ~17.5 cm (fits A4 with narrow margins)
    WIDTHS = [2.8, 0.8, 0.8, 0.8, 0.8, 3.2, 3.2, 3.0, 1.0, 3.2]

    tbl = doc.add_table(rows=1, cols=len(HEADERS))
    tbl.style = "Table Grid"

    # Header row
    hrow = tbl.rows[0]
    for i, (h, w) in enumerate(zip(HEADERS, WIDTHS)):
        c = hrow.cells[i]
        c.width = Cm(w)
        write_cell(c, h, bold=True,
                   bg="2E4057", fg=(255, 255, 255))

    # Data rows
    for _, row in df_sorted.iterrows():
        spec_v = float(row["Specificity"])
        auc_v  = float(row["AUC"]) if row["AUC"] != "NaN" else 0.0

        sens_str = (f"{row['Sensitivity']:.3f} "
                    f"[{row['Sens_CI_Lo']:.3f}–{row['Sens_CI_Hi']:.3f}]")
        spec_str = (f"{row['Specificity']:.3f} "
                    f"[{row['Spec_CI_Lo']:.3f}–{row['Spec_CI_Hi']:.3f}]")
        acc_str  = (f"{row['Accuracy']:.3f} "
                    f"[{row['Acc_CI_Lo']:.3f}–{row['Acc_CI_Hi']:.3f}]")
        auc_str  = (f"{row['AUC']:.4f} "
                    f"[{row['AUC_CI_Lo']:.4f}–{row['AUC_CI_Hi']:.4f}]"
                    if row["AUC"] != "NaN" else "N/A")

        vals = [
            str(row["Model"]),
            str(int(row["TP"])), str(int(row["TN"])),
            str(int(row["FP"])), str(int(row["FN"])),
            sens_str, spec_str, acc_str,
            f"{row['F1']:.3f}",
            auc_str,
        ]
        bgs = [
            None, None, None, None, None,
            None,
            spec_bg(spec_v),
            None,
            None,
            auc_bg(auc_v),
        ]
        tr = tbl.add_row()
        for i, (val, bg) in enumerate(zip(vals, bgs)):
            c = tr.cells[i]
            write_cell(c, val,
                       bold=(i == 0),
                       align="left" if i == 0 else "center",
                       bg=bg)

    # Footnote
    footnote_text = (
        f"\nEvaluated at the standard 0.50 clinical confidence threshold. "
        f"Sensitivity, Specificity, and Accuracy confidence intervals (CIs) "
        f"computed using the exact Clopper-Pearson binomial method. "
        f"AUC CIs computed using DeLong's asymptotic method; for models "
        f"achieving perfect patient-level score separation (AUC = 1.0000), "
        f"variance is zero and the CI lower bound is estimated conservatively "
        f"using a one-sided normal approximation. "
        f"The external test cohort comprised {n_pos} HD-positive and "
        f"{n_neg} HD-negative patients; wide specificity CIs reflect the "
        f"small aganglionic patient sample, inherent to HD as a rare "
        f"paediatric condition. "
        f"RT-DETR-L and Faster-RCNN classified all patients as HD-positive "
        f"regardless of ground truth (TN = 0, FP = {n_neg}), yielding zero "
        f"specificity and rendering them clinically non-deployable at this "
        f"threshold despite achieving perfect sensitivity. "
        f"Table sorted by patient-level specificity (descending). "
        f"Colour coding — Specificity/AUC: "
        f"Green = 1.000/≥0.999 (optimal); "
        f"Amber = 0.600–0.999/0.950–0.998 (acceptable); "
        f"Red = <0.600/<0.950 (suboptimal). "
        f"TP = True Positive; TN = True Negative; "
        f"FP = False Positive; FN = False Negative."
    )
    p = doc.add_paragraph(footnote_text)
    p.style = doc.styles["Normal"]
    for run in p.runs:
        run.font.size = Pt(8)

    docx_path = os.path.join(OUTPUT_DIR,
                             "Patient_Level_Table_Colourcoded.docx")
    doc.save(docx_path)
    print(f"Saved: {docx_path}")

except ImportError:
    print("python-docx not installed. Run: pip install python-docx --break-system-packages")

# ─────────────────────────────────────────────────────────────
# SELF-CHECK — verify key invariants
# ─────────────────────────────────────────────────────────────
print("\n--- Self-check ---")
errors = []
for r in results:
    total = r["TP"] + r["TN"] + r["FP"] + r["FN"]
    if total != len(sorted_pids):
        errors.append(f"{r['Model']}: confusion matrix sum {total} ≠ {len(sorted_pids)}")
    if r["Sensitivity"] > 0:
        expected_sens = round(r["TP"] / (r["TP"] + r["FN"]), 3)
        if abs(expected_sens - r["Sensitivity"]) > 0.001:
            errors.append(f"{r['Model']}: sensitivity mismatch {r['Sensitivity']} vs {expected_sens}")
    if r["Specificity"] > 0:
        expected_spec = round(r["TN"] / (r["TN"] + r["FP"]), 3)
        if abs(expected_spec - r["Specificity"]) > 0.001:
            errors.append(f"{r['Model']}: specificity mismatch {r['Specificity']} vs {expected_spec}")

if errors:
    print("ERRORS FOUND:")
    for e in errors:
        print(f"  ❌ {e}")
else:
    print("  ✅ All confusion matrix sums correct")
    print("  ✅ All sensitivity values verified")
    print("  ✅ All specificity values verified")
    print(f"  ✅ {len(results)} models evaluated")

print(f"\nAll outputs saved to: {OUTPUT_DIR}")
print("  Patient_Level_Results.csv")
print("  Patient_ROC_Curves.png")
print("  Patient_Level_Table_Colourcoded.docx")
