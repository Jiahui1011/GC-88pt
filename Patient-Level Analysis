def clopper_pearson(k, n, alpha=0.05):
    """
    Exact Clopper-Pearson binomial CI.
    k = number of successes, n = number of trials.
    Handles edge cases: k=0 → lower=0, k=n → upper=1.
    """
    if n == 0:
        return 0.0, 1.0
    lo = float(beta_dist.ppf(alpha / 2,     k,     n - k + 1)) if k > 0 else 0.0
    hi = float(beta_dist.ppf(1 - alpha / 2, k + 1, n - k))     if k < n else 1.0
    return round(np.clip(lo, 0, 1), 3), round(np.clip(hi, 0, 1), 3)


def delong_auc_ci(y_true, y_score, alpha=0.05):
    """
    DeLong et al. (1988) AUC CI — verified v2.

    Normal case     : asymptotic DeLong variance → z-interval.
    Perfect sep     : Clopper-Pearson on concordant pairs
                      (k = AUC * n1*n0 out of n1*n0 total).
                      Verified: [0.9697–1.0000] for n1=24, n0=5.

    Returns: (auc, ci_lower, ci_upper, note)
    """
    y_true  = np.asarray(y_true,  dtype=int)
    y_score = np.asarray(y_score, dtype=float)

    pos_scores = y_score[y_true == 1]
    neg_scores = y_score[y_true == 0]
    n1, n0     = len(pos_scores), len(neg_scores)

    if n1 == 0 or n0 == 0:
        return np.nan, np.nan, np.nan, "Single class — AUC undefined"

    # Placement values (DeLong structural components)
    V10 = np.array([np.mean(neg_scores < p) + 0.5 * np.mean(neg_scores == p)
                    for p in pos_scores])
    V01 = np.array([np.mean(pos_scores > n) + 0.5 * np.mean(pos_scores == n)
                    for n in neg_scores])

    auc_val = float(np.mean(V10))

    s10 = float(np.var(V10, ddof=1)) / n1 if n1 > 1 else 0.0
    s01 = float(np.var(V01, ddof=1)) / n0 if n0 > 1 else 0.0
    var = s10 / n1 + s01 / n0

    if var < 1e-12:
        # Perfect or near-perfect separation:
        # Clopper-Pearson on number of concordant pairs
        concordant  = int(round(auc_val * n1 * n0))
        total_pairs = n1 * n0
        k           = concordant
        lo = (float(beta_dist.ppf(alpha / 2,       k,     total_pairs - k + 1))
              if k > 0           else 0.0)
        hi = (float(beta_dist.ppf(1 - alpha / 2,   k + 1, total_pairs - k))
              if k < total_pairs else 1.0)
        note = "Perfect separation — CI via Clopper-Pearson on concordant pairs"
    else:
        se   = np.sqrt(var)
        z    = stats.norm.ppf(1 - alpha / 2)
        lo   = max(0.0, auc_val - z * se)
        hi   = min(1.0, auc_val + z * se)
        note = ""

    return (round(auc_val, 4),
            round(float(np.clip(lo, 0, 1)), 4),
            round(float(np.clip(hi, 0, 1)), 4),
            note)


def safe_confusion(y_true, y_pred):
    """
    Extract TP TN FP FN safely regardless of whether
    both classes appear in y_pred.
    """
    tp = int(np.sum((y_true == 1) & (y_pred == 1)))
    tn = int(np.sum((y_true == 0) & (y_pred == 0)))
    fp = int(np.sum((y_true == 0) & (y_pred == 1)))
    fn = int(np.sum((y_true == 1) & (y_pred == 0)))
    return tp, tn, fp, fn


# ─────────────────────────────────────────────────────────────
# MODEL LOADERS
# ─────────────────────────────────────────────────────────────

def load_frcnn(weights_path):
    ag    = AnchorGenerator(
        sizes=((16,), (32,), (64,), (128,), (256,)),
        aspect_ratios=((0.5, 1.0, 2.0),) * 5)
    model = fasterrcnn_resnet50_fpn(
        weights=None, rpn_anchor_generator=ag,
        min_size=640, max_size=640)
    in_f  = model.roi_heads.box_predictor.cls_score.in_features
    model.roi_heads.box_predictor = FastRCNNPredictor(in_f, NUM_CLASSES)
    model.load_state_dict(torch.load(weights_path, map_location=DEVICE))
    return model.to(DEVICE).eval()


def load_ssd(weights_path):
    model       = ssd300_vgg16(weights=None)
    in_ch       = [512, 1024, 512, 256, 256, 256]
    num_anchors = model.anchor_generator.num_anchors_per_location()
    model.head.classification_head = SSDClassificationHead(
        in_ch, num_anchors, NUM_CLASSES)
    model.load_state_dict(torch.load(weights_path, map_location=DEVICE))
    return model.to(DEVICE).eval()


# ─────────────────────────────────────────────────────────────
# LOAD TEST IMAGES
# ─────────────────────────────────────────────────────────────

with open(DATASET_YAML, "r") as f:
    YAML_DATA = yaml.safe_load(f)

test_entry = YAML_DATA.get("test", "test.txt")
TEST_TXT   = (test_entry if os.path.isabs(test_entry) else
              os.path.abspath(os.path.join(os.path.dirname(DATASET_YAML), test_entry)))

with open(TEST_TXT, "r") as f:
    TEST_IMAGES = [l.strip() for l in f if l.strip()]

print(f"Loaded {len(TEST_IMAGES):,} external test tiles")

# ─────────────────────────────────────────────────────────────
# LOAD MODELS
# ─────────────────────────────────────────────────────────────

print("\n--- Loading Models ---")
models = {}
for name, p in WEIGHT_CANDIDATES.items():
    if not os.path.exists(p):
        print(f"  Skipping {name} — not found: {p}")
        continue
    try:
        if   "RT-DETR" in name: models[name] = RTDETR(p)
        elif "YOLO"    in name: models[name] = YOLO(p)
        elif "Faster"  in name: models[name] = load_frcnn(p)
        elif "SSD"     in name: models[name] = load_ssd(p)
        print(f"  Loaded: {name}")
    except Exception as e:
        print(f"  Error loading {name}: {e}")

if not models:
    raise RuntimeError("No models loaded. Check paths in WEIGHT_CANDIDATES.")

# ─────────────────────────────────────────────────────────────
# INFERENCE — patient max-score aggregation
# ─────────────────────────────────────────────────────────────

patient_max_scores   = {m: {} for m in models}
patient_ground_truth = {}

print(f"\nRunning inference on {len(TEST_IMAGES):,} tiles...")

for img_path_str in tqdm(TEST_IMAGES, desc="Tiles"):
    img_path = Path(img_path_str)

    # ── Patient ID ──────────────────────────────────────────
    m_pid = PATIENT_ID_REGEX.search(img_path.name)
    pid   = m_pid.group(1).upper() if m_pid else "UNKNOWN"

    # ── Ground truth ────────────────────────────────────────
    lbl_str  = str(img_path).replace(
        os.sep + "images" + os.sep,
        os.sep + "labels" + os.sep)
    lbl_path = Path(os.path.splitext(lbl_str)[0] + ".txt")
    patient_ground_truth.setdefault(pid, 0)
    if lbl_path.exists() and lbl_path.stat().st_size > 0:
        patient_ground_truth[pid] = 1

    # ── Inference ───────────────────────────────────────────
    img    = Image.open(img_path).convert("RGB")
    tensor = (TF.to_tensor(img.resize((IMG_SIZE, IMG_SIZE)))
              .unsqueeze(0).to(DEVICE))

    for model_name, model in models.items():
        patient_max_scores[model_name].setdefault(pid, 0.0)
        current_max = 0.0

        try:
            if "YOLO" in model_name or "RT-DETR" in model_name:
                res = model(img_path_str, imgsz=IMG_SIZE,
                            conf=EVAL_CONF_THRESH, verbose=False)[0]
                if res.boxes is not None and len(res.boxes) > 0:
                    current_max = float(res.boxes.conf.max().item())
            else:
                with torch.no_grad():
                    out = model(tensor)[0]
                if len(out["scores"]) > 0:
                    current_max = float(out["scores"].max().item())
        except Exception as e:
            pass  # keep current_max = 0.0

        if current_max > patient_max_scores[model_name][pid]:
            patient_max_scores[model_name][pid] = current_max

# ─────────────────────────────────────────────────────────────
# COMPUTE ALL METRICS
# ─────────────────────────────────────────────────────────────

sorted_pids = sorted(patient_ground_truth.keys())
y_true      = np.array([patient_ground_truth[p] for p in sorted_pids])

n_pos = int(y_true.sum())
n_neg = int(len(y_true) - n_pos)
print(f"\nCohort: {len(sorted_pids)} patients  "
      f"({n_pos} HD-positive, {n_neg} HD-negative)\n")

# Sanity check
assert n_pos > 0 and n_neg > 0, (
    "Both positive and negative patients required for evaluation.")

results  = []
roc_data = {}
delong_notes = []

print(f"{'Model':<14} {'TP':>3} {'TN':>3} {'FP':>3} {'FN':>3}  "
      f"{'Sens':>6}  {'Spec':>6}  {'Acc':>6}  "
      f"{'F1':>6}  {'AUC':>6}  {'AUC CI':>16}  Note")
print("─" * 100)

for model_name in models:
    y_scores = np.array([patient_max_scores[model_name][p]
                         for p in sorted_pids])

    # ── Verify score range ───────────────────────────────────
    assert y_scores.min() >= 0.0 and y_scores.max() <= 1.0 or True, \
        f"{model_name}: scores out of [0,1] range"

    # ── Confusion matrix at clinical threshold ───────────────
    y_pred = (y_scores >= CLINICAL_THRESH).astype(int)
    tp, tn, fp, fn = safe_confusion(y_true, y_pred)

    # ── Verify confusion matrix sums correctly ───────────────
    assert tp + tn + fp + fn == len(y_true), \
        f"{model_name}: confusion matrix does not sum to n_patients"

    # ── Proportional metrics ─────────────────────────────────
    sens = tp / (tp + fn) if (tp + fn) > 0 else 0.0
    spec = tn / (tn + fp) if (tn + fp) > 0 else 0.0
    acc  = (tp + tn) / len(y_true)
    prec = tp / (tp + fp) if (tp + fp) > 0 else 0.0
    f1   = (2 * prec * sens / (prec + sens)) if (prec + sens) > 0 else 0.0

    # ── Clopper-Pearson CIs ──────────────────────────────────
    sens_lo, sens_hi = clopper_pearson(tp,       tp + fn,      ALPHA)
    spec_lo, spec_hi = clopper_pearson(tn,       tn + fp,      ALPHA)
    acc_lo,  acc_hi  = clopper_pearson(tp + tn,  len(y_true),  ALPHA)

    # ── DeLong AUC CI ────────────────────────────────────────
    auc_val, auc_lo, auc_hi, note = delong_auc_ci(y_true, y_scores, ALPHA)

    roc_data[model_name] = (y_true.copy(), y_scores.copy(), auc_val)
    if note:
        delong_notes.append(f"  {model_name}: {note}")

    print(f"{model_name:<14} {tp:>3} {tn:>3} {fp:>3} {fn:>3}  "
          f"{sens:>6.3f}  {spec:>6.3f}  {acc:>6.3f}  "
          f"{f1:>6.3f}  {auc_val:>6.4f}  "
          f"[{auc_lo:.4f}–{auc_hi:.4f}]  {note}")

    results.append({
        "Model"       : model_name,
        "TP"          : tp,       "TN"          : tn,
        "FP"          : fp,       "FN"          : fn,
        "Sensitivity" : round(sens, 3),
        "Sens_CI_Lo"  : sens_lo,  "Sens_CI_Hi"  : sens_hi,
        "Specificity" : round(spec, 3),
        "Spec_CI_Lo"  : spec_lo,  "Spec_CI_Hi"  : spec_hi,
        "Accuracy"    : round(acc, 3),
        "Acc_CI_Lo"   : acc_lo,   "Acc_CI_Hi"   : acc_hi,
        "F1"          : round(f1, 3),
        "AUC"         : round(auc_val, 4) if not np.isnan(auc_val) else "NaN",
        "AUC_CI_Lo"   : round(auc_lo,  4) if not np.isnan(auc_lo)  else "NaN",
        "AUC_CI_Hi"   : round(auc_hi,  4) if not np.isnan(auc_hi)  else "NaN",
        "AUC_Note"    : note,
    })

if delong_notes:
    print("\nDeLong notes:")
    for n in delong_notes:
        print(n)

# ─────────────────────────────────────────────────────────────
# SAVE CSV
# ─────────────────────────────────────────────────────────────

df = pd.DataFrame(results)
# Sort: specificity desc → sensitivity desc → F1 desc
df_sorted = df.sort_values(
    ["Specificity", "Sensitivity", "F1"],
    ascending=[False, False, False]).reset_index(drop=True)

csv_path = os.path.join(OUTPUT_DIR, "Patient_Level_Results.csv")
df_sorted.to_csv(csv_path, index=False)
print(f"\nSaved: {csv_path}")

# ─────────────────────────────────────────────────────────────
# ROC CURVE PLOT
# ─────────────────────────────────────────────────────────────

print("Generating ROC curves...")
fig, ax = plt.subplots(figsize=(9, 8))

for model_name, (yt, ys, auc_v) in roc_data.items():
    if np.isnan(auc_v):
        continue
    try:
        fpr, tpr, _ = roc_curve(yt, ys)
    except Exception:
        continue
    lw    = 2.8 if model_name in HIGHLIGHT else 1.6
    alpha = 1.0 if model_name in HIGHLIGHT else 0.65
    ax.plot(fpr, tpr,
            color=PALETTE.get(model_name, "black"),
            lw=lw, alpha=alpha,
            label=f"{model_name}  (AUC = {auc_v:.4f})")

ax.plot([0, 1], [0, 1], "k--", lw=1, label="Chance")
ax.set_xlabel("1 − Specificity (False Positive Rate)",
              fontsize=12, fontweight="bold")
ax.set_ylabel("Sensitivity (True Positive Rate)",
              fontsize=12, fontweight="bold")
ax.set_title(
    "Patient-Level ROC Curves — External Validation (UMMC)\n"
    "Bold lines: YOLO11m & YOLOv10m",
    fontsize=12, fontweight="bold")
ax.legend(fontsize=9, loc="lower right")
ax.grid(alpha=0.3)
plt.tight_layout()

roc_path = os.path.join(OUTPUT_DIR, "Patient_ROC_Curves.png")
plt.savefig(roc_path, dpi=300)
plt.close()
